# ─── Django ───────────────────────────────────────────────────────────────────
DEBUG=True
SECRET_KEY=django-insecure-change-this-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:beriole@db:5432/smartschool

# ─── Redis & Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://127.0.0.1:8081

# ─── Email ────────────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=votre_email@gmail.com
EMAIL_HOST_PASSWORD=votre_mot_de_passe_app
DEFAULT_FROM_EMAIL=EduTrack <votre_email@gmail.com>
ADMIN_EMAIL=votre_email@gmail.com

# ─── Fapshi (MTN MoMo + Orange Money Cameroun) ───────────────────────────────
FAPSHI_API_USER=votre_api_user_fapshi
FAPSHI_API_KEY=votre_api_key_fapshi
FAPSHI_BASE_URL=https://live.fapshi.com

# ─── AWS S3 (optionnel en dev) ────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=eu-west-3

# ─── Firebase Cloud Messaging ─────────────────────────────────────────────────
FIREBASE_SERVER_KEY=

# ─── Sentry (optionnel) ───────────────────────────────────────────────────────
SENTRY_DSN=

# ─── AI (optionnel en dev) ────────────────────────────────────────────────────
# Groq (API OpenAI-compatible) — fournisseur IA par defaut. Cle: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Autres fournisseurs (optionnels)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
